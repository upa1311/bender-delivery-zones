# --- Large / generated geodata: NEVER commit -------------------------------
# Source extracts, routing graphs, spatial databases and derived data are
# regenerated from config + manifests and must stay out of version control.
*.osm.pbf
*.osm.bz2
*.osm.gz
*.osm.xml
*.pbf
*.o5m
*.osm.o5m
*.poly
*.gpkg
*.geopackage
*.sqlite
*.sqlite3
*.mbtiles
*.db
*.gpkg-journal
# routing graph / engine artifacts (not produced in this stage, blocked anyway)
*.osrm
*.osrm.*
*.ghz
graph.bin
valhalla_tiles/
*.graph

# Generated GeoJSON extracts / clips (keep small hand-written fixtures via allowlist below)
*.geojson
*.geojsonl
*.geojson.seq

# --- Data directories: keep the folders, ignore their contents -------------
data/raw/*
data/interim/*
data/processed/*
data/manifests/*
!data/**/.gitkeep
# Manifests ARE provenance and should be committed when intentionally added:
!data/manifests/*.json

# --- Reports: keep the folder; generated audit outputs stay local ----------
reports/stage-01/*
!reports/**/.gitkeep
# Exception: the two published stage-01 audit deliverables ARE committed.
!reports/stage-01/source-audit.json
!reports/stage-01/source-audit.md

# --- Stage-02 public map: small hand-committed data for docs/ ---------------
# The global *.geojson rule above still ignores large interim clips in
# data/interim/; here we re-include only the small map data under docs/data/.
!docs/data/*.geojson
!docs/data/*.json
!docs/data/*.csv

# --- Immutable versioned zone release: fully tracked -----------------------
!releases/**/*.geojson
!releases/**/*.json
!releases/**/*.csv

# --- Test fixtures: allow the tiny hand-written OSM XML fixture -------------
!tests/fixtures/*.osm

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Node / Playwright browser test artifacts
node_modules/
playwright-report/
test-results/

# Local OSRM build artifacts (multi-GB, rebuildable from the PBF)
data/interim/osrm/
*.osrm*

.osrm/

# Stage 09 routing cache (regenerable via scripts/stage09_route_all.py)
/docs/data/stage-09-routed.jsonl

# Stage 10B routing-graph cache (regenerable from the full PBF)
/data/interim/stage10b-cargraph.pkl
/data/interim/stage10b-restrictions.json

# Stage 10C edge-graph cache (regenerable; keyed by PBF SHA-256)
/data/interim/stage10c-graph-*.pkl
/data/interim/stage10d-*.pkl

# Google Routes cache — Google content, never committed
/data/interim/google-cache/
/data/interim/stage11-prepared-requests.json
